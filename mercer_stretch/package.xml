<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mercer_stretch</name>
  <version>0.0.0</version>
  <description>Software for the RPI Mercer Lab's Stretch RE1</description>
  <maintainer email="noblez@rpi.edu">Zach Nobles</maintainer>
  <license>TODO: License declaration</license>

  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>python3-dotenv</depend>
  <depend>python3-google-generativeai</depend>
  <exec_depend>mercer_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
